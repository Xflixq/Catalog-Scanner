{
  "name": "@workspace/master-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DTM Inventory Master desktop app + pairing API",
  "bin": {
    "dtm-inventory-master": "./src/cli.js"
  },
  "scripts": {
    "dev": "node ../../scripts/run-electron.mjs src/gui/master/main.mjs",
    "start": "node ../../scripts/run-electron.mjs src/gui/master/main.mjs",
    "dev:api": "node src/cli.js",
    "setup:dev": "node ../../scripts/run-electron.mjs src/gui/setup/main.mjs",
    "build:exe": "node scripts/build-exe.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rebuild:native": "pnpm rebuild better-sqlite3",
    "postinstall": "node -e \"try{require('better-sqlite3');console.log('better-sqlite3 ok for Node '+process.version)}catch(e){console.warn('better-sqlite3 needs rebuild for',process.version,'-',e.message); process.exitCode=0}\"",
    "build:app": "node scripts/build-desktop-apps.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.5",
    "electron": "33.2.1",
    "esbuild": "0.27.3",
    "typescript": "~5.9.2",
    "@electron/packager": "^18.3.6",
    "@electron/rebuild": "^3.7.1"
  },
  "main": "src/gui/master/main.mjs",
  "optionalDependencies": {},
  "productName": "DTM Inventory Master"
}
