{
  "name": "@workspace/master-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DTM Inventory Master desktop app + pairing API",
  "bin": {
    "dtm-inventory-master": "./src/cli.js"
  },
  "scripts": {
    "dev": "electron src/gui/master/main.mjs",
    "start": "electron src/gui/master/main.mjs",
    "dev:api": "node src/cli.js",
    "setup:dev": "electron src/gui/setup/main.mjs",
    "build:exe": "node scripts/build-exe.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rebuild:native": "node -e \"console.log('Native modules are used by Node API child only; run pnpm install if better-sqlite3 is missing.')\"",
    "postinstall": "node -e \"try{require('better-sqlite3');console.log('better-sqlite3 ok for Node')}catch(e){console.warn(String(e.message||e))}\""
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.5",
    "electron": "^33.2.1",
    "esbuild": "0.27.3",
    "typescript": "~5.9.2"
  },
  "main": "src/gui/master/main.mjs"
}
