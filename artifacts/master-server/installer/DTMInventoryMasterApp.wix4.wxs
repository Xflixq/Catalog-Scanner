<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="DTM Inventory Master"
    Manufacturer="DTM"
    Version="1.3.1"
    UpgradeCode="8F3C2A11-6B9E-4D2F-9C71-1A0E5B8D4F22"
    Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DTM Inventory Master" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="DTM Inventory" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="ProductFeature" Title="DTM Inventory Master" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="Shortcuts" />
    </Feature>

    <!-- AppFiles group is generated by heat/harvest into AppFiles.wxs, or use DirectoryRef payload -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="*">
        <File Id="MasterExe" Source="$(var.AppDir)\DTMInventoryMaster.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="Shortcuts" Directory="INSTALLFOLDER" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
      <Shortcut
        Id="StartMenuShortcut"
        Directory="ApplicationProgramsFolder"
        Name="DTM Inventory Master"
        Target="[INSTALLFOLDER]DTMInventoryMaster.exe"
        WorkingDirectory="INSTALLFOLDER"
        Icon="AppIcon" />
      <Shortcut
        Id="DesktopShortcut"
        Directory="DesktopFolder"
        Name="DTM Inventory Master"
        Target="[INSTALLFOLDER]DTMInventoryMaster.exe"
        WorkingDirectory="INSTALLFOLDER"
        Icon="AppIcon" />
      <RemoveFolder Id="RemoveStartMenu" Directory="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\DTM\DTMInventoryMaster" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
